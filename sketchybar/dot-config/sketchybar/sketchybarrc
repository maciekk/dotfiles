#!/bin/bash
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"

# Native menu bar auto-hides; Ice remains accessible when it is revealed.
# Stay above normal windows, but below the revealed native menu bar.
# AeroSpace reserves 32pt at the top on external displays; macOS already
# reserves the notch area on the built-in display.
sketchybar --bar position=top height=28 margin=0 y_offset=0 \
  color="$BAR" topmost=window sticky=on show_in_fullscreen=off \
  padding_left=8 padding_right=8 shadow=off

sketchybar --default \
  icon.font='JetBrainsMono Nerd Font Mono:Regular:15.0' \
  label.font='Helvetica Neue:Medium:13.0' \
  icon.color="$TEXT" label.color="$TEXT" \
  padding_left=4 padding_right=4 \
  icon.padding_left=2 icon.padding_right=3 \
  label.padding_left=1 label.padding_right=2 \
  background.drawing=off background.height=0 background.corner_radius=0

sketchybar --add event aerospace_workspace_change

# An invisible controller reconciles app indicators and new named workspaces.
# Polling catches window opens/closes and title changes missed by callbacks.
sketchybar --add item aerospace_controller left \
  --set aerospace_controller drawing=off update_freq=5 \
    script="$PLUGIN_DIR/aerospace.sh" \
  --subscribe aerospace_controller aerospace_workspace_change \
    front_app_switched space_change system_woke

# Visually separate workspaces from the focused window title.
sketchybar --add item workspace_separator left \
  --set workspace_separator icon='┃' icon.font='Helvetica Neue:Bold:17.0' \
    icon.color="$TEXT" icon.padding_left=6 icon.padding_right=10 \
    label.drawing=off

# Keep the title out of the MacBook's central camera notch.
sketchybar --add item front_window left \
  --set front_window icon.drawing=off label.max_chars=55 label.color="$MUTED"

sketchybar --add item clock right \
  --set clock icon='' update_freq=30 script="$PLUGIN_DIR/status.sh" \
  --subscribe clock system_woke \
  --add item battery right \
  --set battery icon='' \
  --add item volume right \
  --set volume icon='󰕾' \
    script="$PLUGIN_DIR/status.sh" \
    click_script='open "x-apple.systempreferences:com.apple.Sound-Settings.extension"' \
  --subscribe volume volume_change

sketchybar --update
